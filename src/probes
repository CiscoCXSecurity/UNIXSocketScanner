# ----------------------------------------------------------------------
# HTTP
# ----------------------------------------------------------------------

http-get	GET / HTTP/1.0\n\n	^HTTP/1.0 200 OK.*
http-get-crlf	GET / HTTP/1.0\r\n\r\n	^HTTP/[0-9]+\.[0-9]+ [0-9]{3}
http-head-crlf	HEAD / HTTP/1.0\r\n\r\n	^HTTP/[0-9]+\.[0-9]+ [0-9]{3}
http-get-11-crlf	GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n	^HTTP/[0-9]+\.[0-9]+ [0-9]{3}
http-options-crlf	OPTIONS / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n	^HTTP/[0-9]+\.[0-9]+ [0-9]{3}

# common local-service HTTP endpoints

http-version	GET /version HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n	^HTTP/[0-9]+\.[0-9]+ [0-9]{3}
http-status	GET /status HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n	^HTTP/[0-9]+\.[0-9]+ [0-9]{3}
http-metrics	GET /metrics HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n	^HTTP/[0-9]+\.[0-9]+ [0-9]{3}

# ----------------------------------------------------------------------
# Docker HTTP APIs
# ----------------------------------------------------------------------

docker-ping	GET /_ping HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n	^HTTP/[0-9]+\.[0-9]+ [0-9]{3}\r?\n.*(?:OK|Docker)
docker-version	GET /version HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n	^HTTP/[0-9]+\.[0-9]+ [0-9]{3}.*(?:ApiVersion|Version|MinAPIVersion)
docker-info	GET /info HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n	^HTTP/[0-9]+\.[0-9]+ [0-9]{3}.*(?:Containers|Driver|ServerVersion)

# ----------------------------------------------------------------------
# Podman HTTP APIs
# ----------------------------------------------------------------------

podman-version	GET /version HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n	^HTTP/[0-9]+\.[0-9]+ [0-9]{3}.*(?:APIVersion|Version|GoVersion)
podman-libpod	GET /libpod/info HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n	^HTTP/[0-9]+\.[0-9]+ [0-9]{3}.*(?:host|version|registries)

